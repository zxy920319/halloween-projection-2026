{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skeleton Mirror frame metadata",
  "type": "object",
  "required": ["version", "type"],
  "properties": {
    "version": { "const": 1 },
    "type": { "enum": ["rgb_frame", "health"] },
    "source": { "type": "string" },
    "frame_id": { "type": "integer", "minimum": 0 },
    "capture_monotonic_ns": { "type": "integer", "minimum": 0 },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "encoding": { "const": "jpeg" },
    "jpeg_quality": { "type": "integer", "minimum": 1, "maximum": 95 },
    "depth_available": { "type": "boolean" },
    "status": { "type": "string" },
    "sent_monotonic_ns": { "type": "integer", "minimum": 0 }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "rgb_frame" } } },
      "then": {
        "required": ["source", "frame_id", "capture_monotonic_ns", "width", "height", "encoding", "depth_available"]
      }
    }
  ],
  "additionalProperties": false
}
